{
  "name": "ansrcli",
  "version": "0.1.6",
  "license": "MIT",
  "bin": {
    "ansr": "dist/cli.js"
  },
  "type": "module",
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/cli.tsx",
    "test": "prettier --check . && xo && ava",
    "setup": "cp sample-quiz-1.example.json sample-quiz-1.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@google/generative-ai": "^0.24.1",
    "@mishieck/ink-titled-box": "^0.3.0",
    "cli-cursor": "^5.0.0",
    "dotenv": "^17.2.3",
    "ink": "^6.5.0",
    "ink-big-text": "^2.0.0",
    "ink-gradient": "^3.0.0",
    "ink-select-input": "^6.2.0",
    "ink-spinner": "^5.0.0",
    "meow": "^14.0.0",
    "react": "^19.2.0",
    "react-error-boundary": "^6.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.2",
    "ava": "^6.2.0",
    "chalk": "^5.2.0",
    "ink-testing-library": "^4.0.0",
    "prettier": "^3.0.0",
    "ts-node": "^10.9.1",
    "tsx": "^4.20.6",
    "typescript": "^5.0.3"
  },
  "ava": {
    "extensions": {
      "ts": "module",
      "tsx": "module"
    },
    "nodeArguments": [
      "--loader=ts-node/esm"
    ]
  }
}
